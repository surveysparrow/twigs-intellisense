{
  "version": "0.2.0",
  "configurations": [
    {
      // Launches the extension in a new window.
      // Run `npm run package:prepare` first to pick up plugin changes.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
      ]
    },
    {
      // Attach to TSServer for debugging plugin code.
      // Requires TSS_DEBUG=9559 in the "Run Extension" environment.
      "name": "Attach to TSServer",
      "type": "node",
      "request": "attach",
      "port": 9559
    }
  ]
}
